# --- ZoidLab SpendGuard (Foundry Package 07) ---
# Shared ZoidLab SSO secret — MUST match the other *.zoidlab.ai apps.
BUILDER_SESSION_SECRET=change-me

# Backend
DATA_DIR=./backend/data
PORT=8701
DATABASE_URL=postgresql://app_rls@127.0.0.1:5433/spendguard
DATABASE_URL_ADMIN=postgresql://foundry@127.0.0.1:5433/spendguard
SPENDGUARD_ADMINS=

# Foundry Pro gate
FOUNDRY_GATE_ENABLED=true
FOUNDRY_REQUIRED_PLAN=pro
MOCK_PRO_USER=false
PRO_TIERS=pro,teams

# Frontend
SPENDGUARD_API_URL=http://127.0.0.1:8701
NYQUEST_API=https://api.nyquest.ai
NYQUEST_APP_ORIGIN=https://app.nyquest.ai
SESSION_COOKIE_DOMAIN=.zoidlab.ai
